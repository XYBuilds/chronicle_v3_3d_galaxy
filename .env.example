# Copy to `.env` in the repo root and fill in values. `.env` is gitignored.
# Never commit `.env` or paste service_role keys into issues/PRs.

# --- Supabase (P18.2+ import & future cron) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_here

# --- Kaggle (P18.4 nightly — optional until cron is wired) ---
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- Cloudflare Pages (P18.6 — optional) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=your_pages_api_token

# --- Cloudflare KV OG index (P34.3 / P38 — optional; see P34.3 guide) ---
# Token name suggestion: the-movie-cosmos-og-index-kv-sync (Workers KV Storage Edit)
# OG_INDEX_KV_NAMESPACE_ID=your_namespace_uuid
# Prefer this dedicated KV token; CLOUDFLARE_API_TOKEN remains the fallback.
# OG_INDEX_KV_API_TOKEN=your_kv_api_token
# Incremental sync defaults: controls count toward PUTs; quota is checked before writes.
# OG_INDEX_MAX_PUTS=900
# OG_INDEX_MAX_DELETES=900
# OG_INDEX_KV_BATCH_SIZE=1000

# --- Cloudflare R2 (P18.6b — optional; all 5 required to enable upload) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# --- Cloudflare Web Analytics (P20.5) ---
# CF_WEB_ANALYTICS_BEACON_TOKEN=

# --- Frontend (Vite; optional — see Tech Spec §5.3 / README) ---
# VITE_KOFI_URL=
# VITE_TALLY_FEEDBACK_FORM_ID=
# VITE_DISCORD_INVITE_URL=

# --- Kaggle API ---
KAGGLE_API_KEY=
KAGGLE_USERNAME=
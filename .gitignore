# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
/env/
*.pyo
*.pdb

# ============================================================
# Raw / large data  (subsample/ is tracked)
# ============================================================
# Match directory or M6 WSL symlink at data/raw (trailing-slash-only rules miss symlinks).
data/raw
data/output/
# P18.1+ local canonical rebuild outputs (large; not versioned)
data/runs/
# P18.5b: written at repo root by scripts/cron/monthly_refit.py (CI artifact; do not commit)
monthly_refit_meta.json
scripts/output/
*.pkl
*.joblib

# ============================================================
# Frontend (Node / Vite / Storybook)
# ============================================================
node_modules/
frontend/dist/
frontend/storybook-static/
frontend/.vite/
frontend/.cache/
# P7.2: ship gzip bundles; pipeline writes .json locally (ignored).
frontend/public/data/*.json
frontend/public/data/*.json.gz
!frontend/public/data/galaxy_data.json.gz
!frontend/public/data/galaxy_search_index.json.gz

# ============================================================
# IDE / OS
# ============================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ============================================================
# Misc
# ============================================================
*.log
logs/
# Ignore scratch under docs/guides; allow committed *.md operator guides.
docs/guides/*
!docs/guides/*.md
.env
.env.*
# Allow committing a template (see root `.env.example`).
!.env.example

{
  "name": "planet-exporter",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --exclude src/*.integration.test.ts",
    "test:integration": "vitest run src/browser.integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint src scripts --ext .ts",
    "evidence:p39.10": "tsx scripts/render-p3910-matrix.ts && tsx scripts/generate-p3910-evidence.ts",
    "evidence:p39.11:a": "tsx scripts/generate-p3911-checkpoint-a-evidence.ts",
    "evidence:p39.11:b": "tsx scripts/generate-p3911-checkpoint-b-evidence.ts",
    "evidence:p39.11:c:threshold": "tsx scripts/generate-p3911-checkpoint-c-threshold-evidence.ts",
    "evidence:p39.11:c:radius": "tsx scripts/generate-p3911-checkpoint-c-radius-evidence.ts",
    "evidence:p39.11:c:strength": "tsx scripts/generate-p3911-checkpoint-c-strength-evidence.ts",
    "evidence:p39.11:final": "tsx scripts/generate-p3911-final-evidence.ts",
    "evidence:p41.1": "tsx scripts/generate-p41-baseline.ts",
    "evidence:p41.4": "tsx scripts/generate-p41-fixed-shaping-evidence.ts",
    "evidence:p41.5": "tsx scripts/generate-p41-emission-evidence.ts",
    "evidence:p41.5:cdf-lut": "tsx scripts/generate-p41-midrank-cdf-lut-evidence.ts",
    "evidence:p41.6": "tsx scripts/generate-p416-bloom-integration-evidence.ts",
    "evidence:p41.6:v2-threshold": "tsx scripts/generate-p416-bloom-integration-evidence.ts --candidate v2-threshold",
    "evidence:p41.6:v3-contrast": "tsx scripts/generate-p416-bloom-integration-evidence.ts --candidate v3-contrast",
    "evidence:p41.6:v4-safe-strength": "tsx scripts/generate-p416-bloom-integration-evidence.ts --candidate v4-safe-strength",
    "evidence:p41.6:v5-high-strength": "tsx scripts/generate-p416-bloom-integration-evidence.ts --candidate v5-high-strength",
    "contact-sheet": "tsx scripts/generate-contact-sheet.ts"
  },
  "dependencies": {
    "playwright": "1.52.0",
    "tsx": "4.19.0",
    "vite": "8.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "sharp": "^0.34.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.4"
  }
}
